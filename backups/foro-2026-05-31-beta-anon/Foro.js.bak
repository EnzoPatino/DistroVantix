// ==========================================
// 1. CONFIGURACIÓN E INICIALIZACIÓN DE SUPABASE
// ==========================================
// Reemplaza con los datos de "Project Settings > API" de tu panel de Supabase
const SUPABASE_URL = "https://hagcsftbwbglyjdtvrnz.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_pX1pErOuGyzRWj9PTnqQtQ_Yno8idk5";

const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const ESTADO_PUBLICADO = "publicado";
const PERFIL_POR_DEFECTO = {
  username: "Usuario Linux",
  avatar_url: "UL",
  rol: "usuario",
  distro: "Distro favorita no indicada",
};
const USUARIO_BETA = {
  email: "beta@distrovantix.test",
  password: "BetaDistroVantix2026!",
};

// ==========================================
// 2. CAPTURA DE ELEMENTOS DEL DOM
// ==========================================
const commentForm = document.getElementById("comment-form");
const commentContent = document.getElementById("comment-content");
const charCount = document.getElementById("char-count");
const commentList = document.getElementById("comment-list");
const loadingState = document.getElementById("loading-state");
const emptyState = document.getElementById("empty-state");
const sessionToggle = document.getElementById("session-toggle");
const authState = document.getElementById("auth-state");
const guestMessage = document.getElementById("guest-message");
const authForm = document.getElementById("auth-form");
const authEmail = document.getElementById("auth-email");
const authPassword = document.getElementById("auth-password");
const authFeedback = document.getElementById("auth-feedback");
const betaLogin = document.getElementById("beta-login");
const profileCard = document.getElementById("profile-card");

// Elementos de la tarjeta de perfil lateral
const profileAvatar = document.getElementById("profile-avatar");
const profileUsername = document.getElementById("profile-username");
const profileDistro = document.getElementById("profile-distro");
const profileStatus = document.getElementById("profile-status");
const profileRole = document.getElementById("profile-role");

function escapeHTML(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function columnaNoExiste(error, columna) {
  return (
    error?.code === "42703" ||
    error?.message?.toLowerCase().includes(`'${columna}'`) ||
    error?.message?.toLowerCase().includes(`column ${columna}`)
  );
}

function mensajeErrorInsercion(error) {
  if (error?.code === "23503") {
    return "Error: el usuario activo no existe en la tabla usuario. Revisa el UUID del perfil.";
  }

  if (error?.code === "23502") {
    return "Error: falta completar un campo obligatorio de la tabla comentario.";
  }

  if (error?.code === "42501" || error?.message?.includes("row-level security")) {
    return "Error: Supabase bloqueó la inserción por políticas de seguridad. Ejecuta sql/foro_policies_supabase.sql en el SQL Editor de Supabase.";
  }

  return `Error de inserción: ${error?.message || "verifica las restricciones de la tabla."}`;
}

function nombreDesdeEmail(email) {
  return email?.split("@")[0] || PERFIL_POR_DEFECTO.username;
}

function crearPerfilDesdeAuth(user) {
  return {
    id_usuario: user.id,
    username:
      user.user_metadata?.nombre_usuario ||
      user.user_metadata?.name ||
      nombreDesdeEmail(user.email),
    avatar_url: user.user_metadata?.avatar_url || PERFIL_POR_DEFECTO.avatar_url,
    rol: PERFIL_POR_DEFECTO.rol,
    distro: PERFIL_POR_DEFECTO.distro,
  };
}

async function buscarPerfilUsuario(user) {
  const perfilAuth = crearPerfilDesdeAuth(user);

  const { data, error } = await supabaseClient
    .from("usuario")
    .select("id_usuario, nombre_usuario, foto_usuario, distro_favorita, estado, rol")
    .eq("id_usuario", user.id)
    .maybeSingle();

  if (error) {
    console.warn("No se pudo leer el perfil local:", error.message);
    return perfilAuth;
  }

  if (!data) {
    await crearPerfilUsuarioSiFalta(perfilAuth);
    return perfilAuth;
  }

  return {
    id_usuario: data.id_usuario,
    username: data.nombre_usuario || perfilAuth.username,
    avatar_url: data.foto_usuario || perfilAuth.avatar_url,
    rol: data.rol || perfilAuth.rol,
    distro: data.distro_favorita || perfilAuth.distro,
    estado: data.estado || "activo",
  };
}

async function crearPerfilUsuarioSiFalta(perfil) {
  const { error } = await supabaseClient.from("usuario").insert([
    {
      id_usuario: perfil.id_usuario,
      nombre_usuario: perfil.username,
      foto_usuario: perfil.avatar_url,
      distro_favorita: perfil.distro,
      estado: "activo",
      rol: "usuario",
    },
  ]);

  if (error) {
    console.warn("No se pudo crear el perfil local:", error.message);
  }
}

function mostrarSesionActiva(perfil) {
  usuarioLogueado = perfil;

  sessionToggle.textContent = "Cerrar sesión";
  authState.textContent = "Sesión activa";
  authState.classList.add("is-active");
  authState.style.backgroundColor = "";

  guestMessage.style.display = "none";
  if (authForm) authForm.hidden = true;
  commentForm.hidden = false;

  if (profileAvatar) profileAvatar.textContent = perfil.avatar_url;
  if (profileUsername) profileUsername.textContent = perfil.username;
  if (profileDistro) profileDistro.textContent = perfil.distro;
  if (profileStatus) profileStatus.textContent = perfil.estado || "activo";
  if (profileRole) profileRole.textContent = perfil.rol;
  if (profileCard) profileCard.style.display = "block";
}

function mostrarSesionCerrada() {
  usuarioLogueado = null;

  sessionToggle.textContent = "Iniciar sesión";
  authState.textContent = "Sin sesión";
  authState.classList.remove("is-active");
  authState.style.backgroundColor = "";

  guestMessage.style.display = "block";
  if (authForm) authForm.hidden = false;
  commentForm.hidden = true;
  if (profileCard) profileCard.style.display = "none";
}

async function sincronizarSesion() {
  const { data, error } = await supabaseClient.auth.getSession();

  if (error || !data.session?.user) {
    mostrarSesionCerrada();
    return;
  }

  const perfil = await buscarPerfilUsuario(data.session.user);
  mostrarSesionActiva(perfil);
}

async function iniciarSesionConCredenciales(email, password) {
  const login = await supabaseClient.auth.signInWithPassword({
    email,
    password,
  });

  if (!login.error) return login;

  const signup = await supabaseClient.auth.signUp({
    email,
    password,
    options: {
      data: {
        nombre_usuario: nombreDesdeEmail(email),
      },
    },
  });

  return signup;
}

async function consultarComentariosPublicados() {
  const consultaConEstado = await supabaseClient
    .from("comentario")
    .select("id_comentario, contenido, fecha, estado, id_usuario")
    .eq("estado", ESTADO_PUBLICADO)
    .order("fecha", { ascending: false });

  if (!consultaConEstado.error) return consultaConEstado.data;

  if (!columnaNoExiste(consultaConEstado.error, "estado")) {
    throw consultaConEstado.error;
  }

  const consultaSinEstado = await supabaseClient
    .from("comentario")
    .select("id_comentario, contenido, fecha, id_usuario")
    .order("fecha", { ascending: false });

  if (consultaSinEstado.error) throw consultaSinEstado.error;

  return consultaSinEstado.data.map((comentario) => ({
    ...comentario,
    estado: ESTADO_PUBLICADO,
  }));
}

async function insertarComentario(comentario) {
  const insercionConEstado = await supabaseClient.from("comentario").insert([
    {
      contenido: comentario.contenido,
      id_usuario: comentario.id_usuario,
      estado: ESTADO_PUBLICADO,
    },
  ]);

  if (!insercionConEstado.error) return insercionConEstado.data;

  if (!columnaNoExiste(insercionConEstado.error, "estado")) {
    throw insercionConEstado.error;
  }

  const insercionSinEstado = await supabaseClient.from("comentario").insert([
    {
      contenido: comentario.contenido,
      id_usuario: comentario.id_usuario,
    },
  ]);

  if (insercionSinEstado.error) throw insercionSinEstado.error;

  return insercionSinEstado.data;
}

// ==========================================
// 3. LOGICA INTERNA DEL FRONTEND (Interactividad)
// ==========================================

// Contador dinámico de caracteres (Límite de 500 según tu plan)
commentContent.addEventListener("input", () => {
  const currentLength = commentContent.value.length;
  charCount.textContent = `${currentLength}/500`;

  // Alerta visual opcional si se acerca al límite
  if (currentLength >= 450) {
    charCount.style.color = "#ff5555"; // Color de advertencia
  } else {
    charCount.style.color = "";
  }
});

// ==========================================
// 4. LECTURA Y RENDERIZADO DE COMENTARIOS (Supabase -> DOM)
// ==========================================

async function cargarComentarios() {
  try {
    if (!loadingState || !commentList || !emptyState) return;

    loadingState.style.display = "block";
    commentList.innerHTML = "";
    emptyState.style.display = "none";

    const comentarios = await consultarComentariosPublicados();

    loadingState.style.display = "none";

    if (!comentarios || comentarios.length === 0) {
      emptyState.style.display = "block";
      document.getElementById("stat-comments").textContent = "0";
      return;
    }

    document.getElementById("stat-comments").textContent = comentarios.length;

    comentarios.forEach((comentario) => {
      // Si el comentario lo pusiste vos con la sesión de Enzo, usamos sus datos visuales
      // De lo contrario, se muestra como un usuario de la comunidad por defecto
      let autor = {
        username: "Usuario Común",
        avatar_url: "👤",
        rol: "usuario",
      };

      if (
        usuarioLogueado &&
        comentario.id_usuario === usuarioLogueado.id_usuario
      ) {
        autor = {
          username: usuarioLogueado.username,
          avatar_url: usuarioLogueado.avatar_url,
          rol: usuarioLogueado.rol,
        };
      }

      const fechaLegible = new Date(comentario.fecha).toLocaleDateString(
        "es-AR",
        {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        },
      );

      const commentCard = document.createElement("article");
      commentCard.className = `comment-card role-${autor.rol}`;
      commentCard.dataset.id = comentario.id_comentario;

      commentCard.innerHTML = `
                <div class="comment-header">
                    <div class="comment-author-info">
                        <div class="avatar">${autor.avatar_url}</div>
                        <div>
                            <h3 class="author-name">${escapeHTML(autor.username)}</h3>
                            <span class="badge badge-${autor.rol}">${escapeHTML(autor.rol.toUpperCase())}</span>
                        </div>
                    </div>
                    <time class="comment-date" datetime="${escapeHTML(comentario.fecha)}">${fechaLegible}</time>
                </div>
                <div class="comment-body">
                    <p>${escapeHTML(comentario.contenido)}</p>
                </div>
            `;

      commentList.appendChild(commentCard);
    });
  } catch (error) {
    console.error("Error al cargar comentarios:", error.message);
    loadingState.style.display = "none";
    commentList.innerHTML = `<p class="form-feedback error-msg" style="color: #ff5555; text-align: center;">
            Error de conexión al cargar el foro. Intenta recargar la página.
        </p>`;
  }
}

// ==========================================
// 5. AUTENTICACIÓN REAL CON SUPABASE AUTH
// ==========================================

// La inserción usa auth.uid(), por eso no alcanza con simular una sesión visual.
let usuarioLogueado = null;

sessionToggle.addEventListener("click", async () => {
  if (!usuarioLogueado) {
    authEmail?.focus();
    return;
  }

  await supabaseClient.auth.signOut();
  mostrarSesionCerrada();
});

authForm?.addEventListener("submit", async (e) => {
  e.preventDefault();

  const accion = e.submitter?.value || "login";
  const email = authEmail.value.trim();
  const password = authPassword.value;

  authFeedback.textContent =
    accion === "signup" ? "Creando cuenta..." : "Iniciando sesión...";
  authFeedback.style.color = "#eab308";

  const respuesta =
    accion === "signup"
      ? await supabaseClient.auth.signUp({
          email,
          password,
          options: {
            data: {
              nombre_usuario: nombreDesdeEmail(email),
            },
          },
        })
      : await supabaseClient.auth.signInWithPassword({ email, password });

  if (respuesta.error) {
    authFeedback.textContent = `Error de autenticación: ${respuesta.error.message}`;
    authFeedback.style.color = "#ff5555";
    return;
  }

  if (!respuesta.data.session) {
    authFeedback.textContent =
      "Cuenta creada. Revisa el email de confirmación antes de iniciar sesión.";
    authFeedback.style.color = "#22c55e";
    return;
  }

  await sincronizarSesion();
  authPassword.value = "";
  authFeedback.textContent = "";
  await cargarComentarios();
});

betaLogin?.addEventListener("click", async () => {
  authFeedback.textContent = "Entrando como usuario beta...";
  authFeedback.style.color = "#eab308";
  betaLogin.disabled = true;

  const respuesta = await iniciarSesionConCredenciales(
    USUARIO_BETA.email,
    USUARIO_BETA.password,
  );

  betaLogin.disabled = false;

  if (respuesta.error) {
    authFeedback.textContent = `No se pudo entrar como beta: ${respuesta.error.message}`;
    authFeedback.style.color = "#ff5555";
    return;
  }

  if (!respuesta.data.session) {
    authFeedback.textContent =
      "La cuenta beta se creó, pero Supabase pide confirmar el email antes de iniciar sesión.";
    authFeedback.style.color = "#ff5555";
    return;
  }

  await sincronizarSesion();
  authFeedback.textContent = "";
  await cargarComentarios();
});

supabaseClient.auth.onAuthStateChange(async (_event, session) => {
  if (!session?.user) {
    mostrarSesionCerrada();
    return;
  }

  const perfil = await buscarPerfilUsuario(session.user);
  mostrarSesionActiva(perfil);
});

document.addEventListener("DOMContentLoaded", async () => {
  await sincronizarSesion();
  await cargarComentarios();
});

// ==========================================
// 6. ENVÍO DE COMENTARIOS A LA BASE DE DATOS (DOM -> Supabase)
// ==========================================

commentForm.addEventListener("submit", async (e) => {
  e.preventDefault();

  const formFeedback = document.getElementById("form-feedback");
  const contenidoText = commentContent.value.trim();

  if (!contenidoText) {
    formFeedback.textContent = "El comentario no puede estar vacío.";
    formFeedback.style.color = "#ff5555";
    return;
  }

  if (!usuarioLogueado) {
    formFeedback.textContent = "Error: Debes iniciar sesión para publicar.";
    formFeedback.style.color = "#ff5555";
    return;
  }

  try {
    const submitBtn = commentForm.querySelector(".publish-button");
    submitBtn.disabled = true;
    formFeedback.textContent = "Enviando comentario...";
    formFeedback.style.color = "#eab308";

    const { data: sessionData } = await supabaseClient.auth.getSession();
    console.info("Publicando comentario con auth.uid:", sessionData.session?.user?.id);

    await insertarComentario({
      contenido: contenidoText,
      id_usuario: usuarioLogueado.id_usuario,
    });

    commentContent.value = "";
    if (charCount) charCount.textContent = "0/500";

    formFeedback.textContent = "¡Comentario publicado con éxito!";
    formFeedback.style.color = "#22c55e";

    // Volvemos a renderizar la lista completa
    await cargarComentarios();

    submitBtn.disabled = false;

    setTimeout(() => {
      if (formFeedback) formFeedback.textContent = "";
    }, 3000);
  } catch (error) {
    console.error("Error al publicar:", error.message);
    formFeedback.textContent = mensajeErrorInsercion(error);
    formFeedback.style.color = "#ff5555";
    commentForm.querySelector(".publish-button").disabled = false;
  }
});
